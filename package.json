{
  "name": "rewarded",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "postinstall": "pnpm gen",
    "gen": "node tooling/scripts/gen-modules.ts && node apps/web/scripts/build-tokens.ts",
    "bootstrap": "node tooling/bootstrap/bootstrap.ts",
    "dev": "pnpm gen && pnpm --parallel --filter @rewarded/api --filter @rewarded/web run dev",
    "build": "pnpm gen && pnpm -r run build",
    "test": "pnpm gen && vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "pnpm gen && pnpm -r run typecheck",
    "lint": "oxlint --deny-warnings",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "pnpm --filter @rewarded/api run db:migrate",
    "seed:demo": "node tooling/seed/seed-demo.ts",
    "secrets:init": "node tooling/scripts/peppers.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
