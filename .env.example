# Copy to .env for local overrides. Never put secrets in this file or in the repo.

# API
PORT=8787
# Path of the SQLite database (gitignored .data/ by default)
DATABASE_PATH=.data/rewarded.sqlite
# auto | better-sqlite3 | node:sqlite
REWARDED_DB_DRIVER=auto
# Directory with peppers and other local secrets, outside the repo and outside .data/
# Generate with: pnpm secrets:init   (default: ~/.config/rewarded/secrets)
REWARDED_SECRETS_DIR=

# Web (Vite)
VITE_API_BASE=/api/v1
